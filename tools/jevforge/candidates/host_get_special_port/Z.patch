--- a/src/IpaSimulator/DarwinVoucherBridge.cpp
+++ b/src/IpaSimulator/DarwinVoucherBridge.cpp
@@ -163,6 +163,30 @@ __declspec(dllexport) std::uint32_t mach_host_self(void) {
   return ipasim::mach::hostSelfPort();
 }
 
+// Target libdispatch calls host_get_special_port(mach_host_self(), -1,
+// HOST_PORT, &port). Route only that proven capability through the typed Mach
+// namespace. Unsupported selectors remain explicit failures so HOST_PRIV_PORT,
+// HOST_IO_MAIN_PORT, and service ports are never forged from the ordinary host.
+__declspec(dllexport) std::int32_t
+host_get_special_port(std::uint32_t Host, std::int32_t Node,
+                      std::int32_t Selector, std::uint32_t *Port) {
+  if (Host != ipasim::mach::hostSelfPort())
+    return ipasim::mach::SendInvalidDestination;
+
+  ipasim::mach::PortName SpecialPort = ipasim::mach::PortNull;
+  const ipasim::mach::KernelReturn Result =
+      ipasim::mach::getHostSpecialPort(Host, Node, Selector, &SpecialPort);
+  if (Result == ipasim::mach::KernelInvalidHost)
+    return ipasim::mach::SendInvalidDestination;
+  if (Result != ipasim::mach::KernelSuccess)
+    return Result;
+
+  if (!Port || !ipasim::darwinmem::writableSpan(Port, sizeof(*Port)))
+    return ipasim::mach::KernelMemoryError;
+  *Port = SpecialPort;
+  return ipasim::mach::KernelSuccess;
+}
