+KernelReturn getHostSpecialPort(PortName Host, std::int32_t Node,
+                                std::int32_t Selector, PortName *Port) {
+  if (!Port)
+    return KernelInvalidArgument;
+  if (!isLivePortOfKind(Host, PortKind::Host))
+    return KernelInvalidHost;
+
+  // XNU currently ignores the node argument. HOST_LOCAL_NODE (-1) is the
+  // public call shape used by the target, but node does not change selection.
+  (void)Node;
+
+  // HOST_PORT == 1. XNU returns another send right to the same host kernel
+  // object. A Mach namespace may expose the copied right under the same name;
+  // increment the send-right reference count rather than manufacturing a new
+  // object identity.
+  if (Selector == 1) {
+    const PortName Result = hostSelfPort();
+    if (!insertSendRight(Result))
+      return KernelFailure;
+    *Port = Result;
+    return KernelSuccess;
+  }
+
+  if (Selector <= 0)
+    return KernelInvalidArgument;
+
+  diagnostic("requested host special-port selector is not implemented yet");
+  return KernelNotSupported;
+}
