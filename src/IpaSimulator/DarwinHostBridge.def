LIBRARY IpaSimDarwinHost
EXPORTS
    socket=darwin_socket
    connect=darwin_connect
    getuid=darwin_getuid
    geteuid=darwin_geteuid
    getgid=darwin_getgid
    getegid=darwin_getegid
    open=darwin_open
    open$NOCANCEL=darwin_open
    guarded_open_np=darwin_guarded_open_np
    guarded_close_np=darwin_guarded_close_np
    close$NOCANCEL=close
    fcntl$NOCANCEL=fcntl
    fstat=darwin_fstat
    stat=darwin_stat
    lstat=darwin_lstat
    lseek=darwin_lseek
    read=darwin_read
    read$NOCANCEL=darwin_read
    write=darwin_write
    write$NOCANCEL=darwin_write
    pread=darwin_pread
    pread$NOCANCEL=darwin_pread
    pwrite=darwin_pwrite
    pwrite$NOCANCEL=darwin_pwrite
    sigsuspend$NOCANCEL=darwin_sigsuspend_nocancel
    mach_task_self_ DATA
    vm_page_size DATA
    NDR_record DATA
